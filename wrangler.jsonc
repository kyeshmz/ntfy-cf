{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ntfy-kyeshimizu",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-13",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "durable_objects": {
    "bindings": [
      { "name": "TOPIC", "class_name": "Topic" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Topic"]
    }
  ]
}
